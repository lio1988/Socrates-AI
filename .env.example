# API Keys for Socratic Dialog
# Copy this file to .env and fill in your actual keys

ANTHROPIC_API_KEY=sk-ant-your-claude-key-here
XAI_API_KEY=xai-your-grok-key-here
GOOGLE_API_KEY=AIza-your-gemini-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# Optional single-operator remote access; use HTTPS and a strong random password.
# Leaving the password empty permits local loopback access only.
SOCRATES_ACCESS_PASSWORD=
SOCRATES_ALLOWED_HOSTS=localhost,127.0.0.1,::1
