# API Keys for Socratic Dialog
# Copy this file to .env and fill in your actual keys

ANTHROPIC_API_KEY=sk-ant-your-claude-key-here
XAI_API_KEY=xai-your-grok-key-here
GOOGLE_API_KEY=AIza-your-gemini-key-here
OPENAI_API_KEY=sk-your-openai-key-here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# ── Live council configuration (environment variables ONLY) ──────────────────
# These are read from the real environment, not from this file: only backend/
# app.py calls load_dotenv(). The demos and the council builder use os.getenv,
# so export them in your shell before running them.
#
# Engage real providers instead of deterministic mocks.
CED_ENABLE_LIVE_PROVIDERS=1
# One seat per entry: anthropic | nvidia | openrouter | mock
CED_PROVIDER_FAMILIES=openrouter,openrouter,openrouter
# Exact per-seat model ids. Omit to use each family's default model.
CED_OPENROUTER_MODELS=openai/gpt-4.1-mini,openai/gpt-4o-mini,meta-llama/llama-3.3-70b-instruct
# Per-provider call timeout in seconds. Large models need room on the heaviest
# phase; the registry budget wraps every attempt of a call.
CED_LIVE_TIMEOUT=180

# Single-provider OpenRouter smoke (backend/dialogues/demo_openrouter.py).
OPENROUTER_MODEL=openai/gpt-4.1-mini
